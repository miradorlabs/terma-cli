{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v terma >/dev/null 2>&1 && terma hook codex-post-tool-use || true",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v terma >/dev/null 2>&1 && terma hook codex-session-end || true",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v terma >/dev/null 2>&1 && terma hook codex-session-start || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v terma >/dev/null 2>&1 && terma hook codex-stop || true",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v terma >/dev/null 2>&1 && terma hook codex-subagent-start || true",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v terma >/dev/null 2>&1 && terma hook codex-subagent-stop || true",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
