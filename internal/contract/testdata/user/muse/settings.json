    "PostLLMCall": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x '/usr/local/bin/terma' ] && '/usr/local/bin/terma' hook --user muse-post-llm-call || true",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
