{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Agent|Task|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x '/usr/local/bin/terma' ] && '/usr/local/bin/terma' hook --user post-tool-use || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x '/usr/local/bin/terma' ] && '/usr/local/bin/terma' hook --user pre-tool-use || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x '/usr/local/bin/terma' ] && '/usr/local/bin/terma' hook --user session-end || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x '/usr/local/bin/terma' ] && '/usr/local/bin/terma' hook --user session-start || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x '/usr/local/bin/terma' ] && '/usr/local/bin/terma' hook --user stop || true",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x '/usr/local/bin/terma' ] && '/usr/local/bin/terma' hook --user stop-failure || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x '/usr/local/bin/terma' ] && '/usr/local/bin/terma' hook --user subagent-start || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x '/usr/local/bin/terma' ] && '/usr/local/bin/terma' hook --user subagent-stop || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x '/usr/local/bin/terma' ] && '/usr/local/bin/terma' hook --user user-prompt-submit || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
