    {"entry": "github.com//*", "server": false, "cli": "refused"},
    {"entry": "github.com/acme/*?note", "server": false, "cli": "refused"},
    {"entry": "github.com/acme/api#main", "server": false, "cli": "refused"},
    {"entry": "github.com/acme/%2A", "server": false, "cli": "refused"},
    {"entry": "github.com/acme%2F%2A", "server": false, "cli": "refused"},
