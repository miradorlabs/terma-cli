// Attribute keys, terma's own and those it references from OpenTelemetry's registries.
const (
{% for a in ctx.attributes %}
	// {{ goname(a.key) }}Key is {{ a.key }}: {{ brief(a.brief) }}
	{{ goname(a.key) }}Key = "{{ a.key }}"
{% endfor %}
