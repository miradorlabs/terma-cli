{% for a in ctx.attributes if a.type is mapping %}
{% for m in a.type.members if not m.deprecated %}
	// {{ goname(a.key) }}{{ goname(m.id) }} is {{ a.key }} {{ m.value }}{% if m.brief %}: {{ brief(m.brief) }}{% endif %}

	{{ goname(a.key) }}{{ goname(m.id) }} = "{{ m.value }}"
{% endfor %}
