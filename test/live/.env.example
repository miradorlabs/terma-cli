# Copy to live/.env.local (gitignored). Each credential enables the scenarios
# that need it; a missing one is reported as "not run", never as a pass.

# Claude Code on a subscription (Pro, Max, Team, Enterprise): a long-lived token
# from `claude setup-token`. This is the isolated shape and what CI would use.
CLAUDE_CODE_OAUTH_TOKEN=

# Or, on a developer machine, use the real Keychain login instead of a token.
# Skips the contracts that need the scratch config directory to be the one
# Claude reads (the wrapped status line pass-through).
#TERMA_LIVE_REAL_LOGIN=1

# Claude Code on the API-key route (Console billing).
ANTHROPIC_API_KEY=

# Codex on the API-key route.
OPENAI_API_KEY=
